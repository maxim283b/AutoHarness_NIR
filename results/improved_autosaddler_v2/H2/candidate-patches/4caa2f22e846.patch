+// True when the last completed file edit has no completed shell run after it,
+// i.e. the agent edited files and then stopped without verifying the changes.
+function needsPostEditVerification(msgs: SessionV1.WithParts[]) {
+  let lastFileEdit = -1
+  let lastShell = -1
+  let idx = 0
+  for (const msg of msgs) {
+    for (const part of msg.parts) {
+      if (part.type === "tool" && part.state.status === "completed") {
+        if (FILE_EDIT_TOOLS.has(part.tool)) lastFileEdit = idx
+        else if (part.tool === ShellID.ToolID) lastShell = idx
+      }
+      idx++
+    }
+  }
+  return lastFileEdit !== -1 && lastShell < lastFileEdit
+}
