 }
 
+const FILE_EDIT_TOOLS = new Set(["edit", "write", "apply_patch", "multiedit"])
+
+// Cap the number of times we steer a session that keeps stopping without edits.
+const ZERO_PROGRESS_STEER_LIMIT = 2
+const zeroProgressSteers = new Map<string, number>()
+
+const ZERO_PROGRESS_STEER_TEXT = [
+  `IMPORTANT: Do not finish yet. You have not made any file changes in this session using the edit, write, or apply_patch tools, so the requested work has not been implemented. Continue working immediately: use the file editing tools to actually modify the relevant files. Do not summarize what you have already done, do not describe what you would do, and do not ask for confirmation.
+Once you have made the file changes, verify them (for example by reading the modified files and running the available checks) before finishing.`,
+  `You stopped again without making any file changes. The requested work is still not implemented. You MUST call the edit, write, or apply_patch tool now to modify the relevant files. Do not reply with a summary, a plan, an explanation, or a question, and do not ask for confirmation. Call a file editing tool on the appropriate file in this response.`,
+]
+
+function hasAnyToolPart(msgs: SessionV1.WithParts[]) {
+  return msgs.some((msg) => msg.parts.some((part) => part.type === "tool"))
+}
+
+function hasCompletedFileEdit(msgs: SessionV1.WithParts[]) {
+  return msgs.some((msg) =>
+    msg.parts.some(
+      (part) =>
+        part.type === "tool" &&
+        FILE_EDIT_TOOLS.has(part.tool) &&
+        part.state.status === "completed",
+    ),
+  )
+}
+
 export interface Interface {
   readonly cancel: (sessionID: SessionID) => Effect.Effect<void>
   readonly prompt: (input: PromptInput) => Effect.Effect<SessionV1.WithParts, Image.Error>
