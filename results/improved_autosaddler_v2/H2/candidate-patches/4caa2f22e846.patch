+// Cap the number of times we steer a session that stops immediately after
+// file edits without running any command afterwards to verify them.
+const POST_EDIT_VERIFY_STEER_LIMIT = 1
+const postEditVerifySteers = new Map<string, number>()
+
+const POST_EDIT_VERIFY_STEER_TEXT = `IMPORTANT: Do not finish yet. You made file changes but never ran any command afterwards to verify them. Continue working immediately: run the available checks or tests that cover the files you changed. If a check fails, fix the code and rerun it. Only finish once an actual command confirms your changes work. Do not describe what you would verify, do not claim the changes are correct without running a command, and do not ask for confirmation.`
