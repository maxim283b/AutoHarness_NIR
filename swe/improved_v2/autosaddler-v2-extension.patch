@@ -0,0 +1,172 @@
+"""Durable experiment journal and stage-specific retrieval for AutoSaddler V2.
+
+This extension consumes only optimization events. It does not read held-out cases,
+change evaluation results, or silently infer causality from a score difference.
+"""
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+from autosaddler.v2.core.domain import JsonValue, to_json_value
+from autosaddler.v2.core.events import operation_id
+from autosaddler.v2.storage.local import LocalRunStore
+
+NAMESPACE = "autosaddler.improved_journal"
+
+
+class AdaptiveReflectionMemory:
+    def __init__(self, store: LocalRunStore, *, max_retrieved: int = 4) -> None:
+        if max_retrieved < 1:
+            raise ValueError("max_retrieved must be positive")
+        self.store = store
+        self.max_retrieved = max_retrieved
+
+    def reconcile(self) -> None:
+        """Close the crash window between IterationCompleted and journal commit."""
+        for event in self.store.events_of_type("IterationCompleted"):
+            self.record_iteration(event.payload["iteration"])
+
+    def record_iteration(self, iteration: int) -> None:
+        events = self.store.events()
+        completed = next((e for e in events if e.event_type == "IterationCompleted"
+                          and e.payload.get("iteration") == iteration), None)
+        if completed is None:
+            raise ValueError("Cannot journal an incomplete iteration")
+        scheduled = next((e for e in events if e.event_type == "DeferredWorkScheduled"
+                          and e.payload.get("owning_iteration") == iteration), None)
+        mutation = next((e for e in events if e.event_type == "MutationRejected"
+                         and e.payload.get("iteration") == iteration), None)
+        source = scheduled.payload if scheduled else {}
+        before = _scores(source.get("train_before_case_scores"))
+        after = _scores(source.get("train_after_case_scores"))
+        fixed = sorted(k for k in before.keys() & after.keys() if before[k] == 0 and after[k] > 0)
+        regressed = sorted(k for k in before.keys() & after.keys() if before[k] > 0 and after[k] == 0)
+        entry: dict[str, JsonValue] = {
+            "schema_version": "autosaddler-improved-journal/v1",
+            "iteration": iteration,
+            "problem": source.get("diagnosis") or (mutation.payload.get("verification_failure") if mutation else completed.payload.get("outcome")),
+            "root_cause_hypothesis": source.get("diagnosis"),
+            "proposed_change": source.get("updates"),
+            "changed_components": source.get("changed_components", []),
+            "candidate_id": source.get("candidate_id"),
+            "parent_candidate_id": source.get("working_parent_candidate_id"),
+            "train_before": {"aggregate": source.get("train_before_aggregate"), "case_scores": before},
+            "train_after": {"aggregate": source.get("train_after_aggregate"), "case_scores": after},
+            "validation": {"parent_aggregate": source.get("parent_development_aggregate"),
+                           "candidate_aggregate": source.get("candidate_development_aggregate")},
+            "fixed_case_ids": fixed,
+            "regressed_case_ids": regressed,
+            "outcome": completed.payload.get("outcome"),
+            "accepted": completed.payload.get("accepted") is True,
+            "causal_status": "uncertain",
+            "causal_reason": "Behavioral mechanism has not yet been verified by reflection.",
+            "next_step": "Inspect the changed active code path and matched task traces.",
+            "source_events": [e.operation_id for e in (completed, scheduled, mutation) if e is not None],
+        }
+        self.store.append("ExtensionStateChanged", operation_id(self.store.run_id, "improved-journal", iteration),
+                          {"namespace": NAMESPACE, "kind": "iteration", "entry": entry})
+
+    def record_reflection(self, iteration: int, assessment: Mapping[str, JsonValue], train_case_ids: tuple[str, ...]) -> None:
+        self.record_iteration(iteration)
+        status = assessment.get("status")
+        if status not in {"confirmed", "refuted", "uncertain"}:
+            raise ValueError("Invalid causal status")
+        evidence_ids = assessment.get("evidence_case_ids")
+        if not isinstance(evidence_ids, list) or any(not isinstance(x, str) for x in evidence_ids):
+            raise ValueError("Causal assessment needs evidence case IDs")
+        if not set(evidence_ids) <= set(train_case_ids):
+            raise ValueError("Causal assessment references a non-training case")
+        mechanism = assessment.get("behavioral_mechanism")
+        evidence = assessment.get("evidence")
+        if not isinstance(mechanism, str) or not isinstance(evidence, str):
+            raise ValueError("Causal assessment needs mechanism and evidence")
+        # A metric change alone cannot certify the proposed mechanism.
+        kind = assessment.get("evidence_kind")
+        refs = assessment.get("source_refs")
+        if status == "confirmed" and (kind not in {"trace", "code_route", "tool_behavior"}
+                                      or not isinstance(refs, list) or not refs
+                                      or any(not isinstance(ref, str) or not ref.strip() for ref in refs)
+                                      or not evidence_ids or not mechanism.strip() or not evidence.strip()):
+            raise ValueError("Confirmed mechanism needs behavioral and case evidence")
+        payload = {"namespace": NAMESPACE, "kind": "reflection", "iteration": iteration,
+                   "assessment": to_json_value(assessment)}
+        self.store.append("ExtensionStateChanged", operation_id(self.store.run_id, "improved-reflection", iteration), payload)
+
+    def retrieve(self, stage: str, context: Mapping[str, JsonValue]) -> dict[str, JsonValue]:
+        if stage not in {"evolve", "diagnose_patch", "patch", "reflect"}:
+            raise ValueError("Unknown retrieval stage")
+        self.reconcile()
+        current = context.get("iteration")
+        case_ids = set(x for x in context.get("train_case_ids", []) if isinstance(x, str))
+        reflections = {e.payload.get("iteration"): e.payload.get("assessment")
+                       for e in self.store.events_of_type("ExtensionStateChanged")
+                       if e.payload.get("namespace") == NAMESPACE and e.payload.get("kind") == "reflection"}
+        ranked = []
+        for event in self.store.events_of_type("ExtensionStateChanged"):
+            if event.payload.get("namespace") != NAMESPACE or event.payload.get("kind") != "iteration":
+                continue
+            entry = event.payload["entry"]
+            iteration = entry["iteration"]
+            if isinstance(current, int) and iteration >= current and stage != "reflect":
+                continue
+            if isinstance(current, int) and iteration > current:
+                continue
+            observed = set(entry["train_before"]["case_scores"]) | set(entry["train_after"]["case_scores"])
+            overlap = len(case_ids & observed)
+            score = overlap * 10 + (2 if entry["accepted"] else 0) + (1 if entry["regressed_case_ids"] else 0)
+            if stage == "diagnose_patch" and entry["outcome"] in {"declined", "mutation_rejected"}:
+                score += 3
+            if stage == "patch" and entry["changed_components"]:
+                score += 2
+            if stage == "reflect" and iteration == current:
+                score += 100
+            ranked.append((score, iteration, event.operation_id, entry))
+        ranked.sort(key=lambda row: (row[0], row[1]), reverse=True)
+        records = []
+        for _, iteration, source_id, entry in ranked[:self.max_retrieved]:
+            assessment = reflections.get(iteration)
+            records.append({"iteration": iteration, "source_operation_id": source_id,
+                            "detail_path": f".autosaddler/adaptive_memory/journal/{iteration:04d}.json",
+                            "candidate_id": entry["candidate_id"], "problem": _short(entry["problem"]),
+                            "changed_components": entry["changed_components"],
+                            "fixed_case_ids": entry["fixed_case_ids"], "regressed_case_ids": entry["regressed_case_ids"],
+                            "accepted": entry["accepted"], "outcome": entry["outcome"],
+                            "causal_status": assessment.get("status") if isinstance(assessment, Mapping) else "uncertain",
+                            "causal_evidence": _short(assessment.get("evidence")) if isinstance(assessment, Mapping) else None,
+                            "next_step": _short(assessment.get("next_step")) if isinstance(assessment, Mapping) else entry["next_step"]})
+        return {"schema_version": "autosaddler-adaptive-retrieval/v1", "stage": stage,
+                "source_namespace": NAMESPACE, "records": records,
+                "selection": "case overlap, stage-specific outcome, acceptance, recency; no held-out scores"}
+
+    def selected_details(self, retrieval: Mapping[str, JsonValue]) -> dict[str, str]:
+        selected = {record["iteration"] for record in retrieval["records"]}
+        reflections = {e.payload.get("iteration"): e.payload.get("assessment")
+                       for e in self.store.events_of_type("ExtensionStateChanged")
+                       if e.payload.get("namespace") == NAMESPACE and e.payload.get("kind") == "reflection"}
+        from autosaddler.v2.core.domain import canonical_json
+        files = {}
+        for event in self.store.events_of_type("ExtensionStateChanged"):
+            if event.payload.get("namespace") != NAMESPACE or event.payload.get("kind") != "iteration":
+                continue
+            entry = event.payload["entry"]
+            iteration = entry["iteration"]
+            if iteration in selected:
+                path = f".autosaddler/adaptive_memory/journal/{iteration:04d}.json"
+                files[path] = canonical_json({"source_operation_id": event.operation_id,
+                                              "entry": entry, "reflection": reflections.get(iteration)}) + "\n"
+        if len(files) != len(selected):
+            raise RuntimeError("Retrieved journal detail missing")
+        return files
+
+
+def _scores(value: object) -> dict[str, float]:
+    if not isinstance(value, Mapping):
+        return {}
+    return {str(k): float(v) for k, v in value.items() if isinstance(v, (int, float)) and not isinstance(v, bool)}
+
+
+def _short(value: object, limit: int = 400) -> str | None:
+    if value is None:
+        return None
+    text = str(value)
+    return text[:limit] + ("…" if len(text) > limit else "")
