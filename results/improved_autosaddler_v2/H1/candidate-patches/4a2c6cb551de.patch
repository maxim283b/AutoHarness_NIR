diff --git a/opencode-src/packages/opencode/src/tool/test-integrity.ts b/opencode-src/packages/opencode/src/tool/test-integrity.ts
new file mode 100644
index 0000000..c6e92a0
--- /dev/null
+++ b/opencode-src/packages/opencode/src/tool/test-integrity.ts
@@ -0,0 +1,75 @@
+import * as path from "path"
+import { Effect, Stream } from "effect"
+import { ChildProcess, ChildProcessSpawner } from "effect/unstable/process"
+
+// Heuristic detection of test files. Deliberately broad: the guard is
+// fail-open for anything git cannot confirm as a tracked file, so a false
+// positive only triggers the additive-content rule and a false negative only
+// skips the rule on an untracked-looking path.
+export function isTestFilePath(filePath: string): boolean {
+  const normalized = filePath.replaceAll("\\", "/")
+  if (normalized.includes("node_modules/")) return false
+  const segments = normalized.split("/")
+  const base = segments[segments.length - 1] ?? ""
+  for (const segment of segments.slice(0, -1)) {
+    const lowered = segment.toLowerCase()
+    if (lowered === "test" || lowered === "tests" || lowered === "__tests__") return true
+  }
+  return (
+    (/^test_.+\.py$/.test(base) || /^conftest\.py$/.test(base)) ||
+    /^[^/]+_test\.[^/]+$/.test(base) ||
+    /^[^/]+\.test\.[^/]+$/.test(base) ||
+    /^[^/]+\.spec\.[^/]+$/.test(base) ||
+    /^[^/]+-test\.[^/]+$/.test(base)
+  )
+}
+
+function normalize(text: string): string {
+  return text.replaceAll("\r\n", "\n")
+}
+
+// Fetch the HEAD blob for the file, resolved from the file's own directory so
+// the `./` relative path is stable regardless of repo layout. Returns
+// undefined whenever anything goes wrong (not a repo, no commits, untracked
+// path, spawn failure) so callers fail open.
+function gitHeadContent(spawner: ChildProcessSpawner.ChildProcessSpawner, filePath: string) {
+  return Effect.gen(function* () {
+    const handle = yield* spawner.spawn(
+      ChildProcess.make(
+        "git",
+        ["show", `HEAD:./${path.basename(filePath)}`],
+        { cwd: path.dirname(filePath), extendEnv: true, stdin: "ignore" },
+      ),
+    )
+    const [text, stderr] = yield* Effect.all(
+      [Stream.mkString(Stream.decodeText(handle.stdout)), Stream.mkString(Stream.decodeText(handle.stderr))],
+      { concurrency: 2 },
+    )
+    const code = yield* handle.exitCode
+    return code === 0 ? text : undefined
+  }).pipe(
+    Effect.scoped,
+    Effect.catch(() => Effect.succeed(undefined)),
+  )
+}
+
+// Returns an error message when the requested final content of a git-tracked
+// test file would remove or alter original HEAD content, and undefined when
+// the change is allowed (untracked/non-test file, additive change, or any git
+// failure). The rule: normalized HEAD content must remain a substring of the
+// normalized new content, so appending and anchor-preserving insertions pass
+// while deletions, rewrites, and disabling assertions are blocked.
+export const testIntegrityViolation = (filePath: string, newContent: string) =>
+  Effect.gen(function* () {
+    if (!isTestFilePath(filePath)) return undefined
+    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner
+    const head = yield* gitHeadContent(spawner, filePath)
+    if (head === undefined || head === "") return undefined
+    if (normalize(newContent).includes(normalize(head))) return undefined
+    return (
+      `Refusing to modify tracked test file ${filePath}: the change would remove or alter its ` +
+      `original content. Test files may only be modified additively — every line from the ` +
+      `original file must remain present and unmodified. Restore the original content and, ` +
+      `if needed, append new tests instead of editing, deleting, or weakening existing ones.`
+    )
+  })
