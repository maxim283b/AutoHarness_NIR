+// Cap the number of times we steer a session that keeps stopping while its
+// most recent test-looking command run still reports failing tests.
+const FAILING_TEST_STEER_LIMIT = 2
+const failingTestSteers = new Map<string, number>()
+
+const FAILING_TEST_STEER_TEXT = [
+  `IMPORTANT: Do not finish yet. Your most recent test run reported failing tests, so the requested work is not complete. Continue working immediately: fix the code that causes the remaining test failures, then rerun the failing test suite to confirm the failures are gone. Do not summarize what you have already done, do not claim the work is finished while tests fail, and do not ask for confirmation.`,
+  `You stopped again while tests are still failing. You MUST continue now: fix the code that causes the failing tests and rerun the test suite to confirm it passes before finishing. Do not reply with a summary, an explanation, or a question, and do not ask for confirmation. Take action in this response.`,
+]
+
+const TEST_FAIL_MARKERS = [
+  /^\s*---\s*FAIL:/m,
+  /^\s*FAIL\b/m,
+  /^\s*not ok\b/m,
+  /\b\d+\s+(?:failed|failing)\b/i,
+  /\bfailing tests?\b/i,
+]
+const TEST_PASS_MARKERS = [/\b\d+\s+(?:passed|passing)\b/i, /^\s*---\s*PASS:/m, /^\s*ok\b/m]
+
+const looksLikeTestRun = (output: string) =>
+  TEST_PASS_MARKERS.some((re) => re.test(output)) || TEST_FAIL_MARKERS.some((re) => re.test(output))
+const showsFailingTests = (output: string) => TEST_FAIL_MARKERS.some((re) => re.test(output))
+
+function bashExitCode(part: SessionV1.ToolPart): number | undefined {
+  if (part.state.status !== "completed") return undefined
+  const metadata = part.state.metadata as unknown as { exit?: unknown } | undefined
+  const exit = metadata?.exit
+  return typeof exit === "number" ? exit : undefined
+}
+
+// True when the latest completed bash run that looks like a test suite run
+// still reported failing tests (failure markers plus a non-zero exit code).
+// Unrelated commands (no test-summary markers) are skipped so a rerun that
+// passes prevents the steer.
+function stoppedOnFailingTests(msgs: SessionV1.WithParts[]): boolean {
+  for (let i = msgs.length - 1; i >= 0; i--) {
+    const parts = msgs[i]?.parts
+    if (!parts) continue
+    for (let j = parts.length - 1; j >= 0; j--) {
+      const part = parts[j]
+      if (part.type !== "tool" || part.tool !== ShellID.ToolID) continue
+      if (part.state.status !== "completed") continue
+      const output = part.state.output ?? ""
+      if (!output || !looksLikeTestRun(output)) continue
+      if (!showsFailingTests(output)) return false
+      const exit = bashExitCode(part)
+      return exit !== undefined && exit !== 0
+    }
+  }
+  return false
+}
+
 function hasAnyToolPart(msgs: SessionV1.WithParts[]) {
