             }
+            const steerCount = zeroProgressSteers.get(sessionID) ?? 0
+            if (
+              lastAssistant.finish === "stop" &&
+              !session.parentID &&
+              lastUser.agent !== "plan" &&
+              steerCount < ZERO_PROGRESS_STEER_LIMIT &&
+              hasAnyToolPart(msgs) &&
+              !hasCompletedFileEdit(msgs)
+            ) {
+              // The agent stopped, used tools, but never completed any file
+              // edit. Persist a new durable user steer message so the next
+              // loop iteration reloads it from the database and continues
+              // implementation work instead of exiting.
+              const steerText = ZERO_PROGRESS_STEER_TEXT[Math.min(steerCount, ZERO_PROGRESS_STEER_TEXT.length - 1)]
+              const steerMsg: SessionV1.User = {
+                id: MessageID.ascending(),
+                role: "user",
+                sessionID: lastUser.sessionID,
+                time: { created: Date.now() },
+                agent: lastUser.agent,
+                model: { ...lastUser.model },
+              }
+              const steerPart: SessionV1.TextPart = {
+                id: PartID.ascending(),
+                messageID: steerMsg.id,
+                sessionID: steerMsg.sessionID,
+                type: "text",
+                synthetic: true,
+                text: steerText,
+              }
+              yield* sessions.updateMessage(steerMsg)
+              yield* sessions.updatePart(steerPart)
+              zeroProgressSteers.set(sessionID, steerCount + 1)
+              yield* Effect.logInfo("zero-progress steer", {
+                "session.id": sessionID,
+                attempt: steerCount + 1,
+                messageID: steerMsg.id,
+              })
+              continue
+            }
             yield* Effect.logInfo("exiting loop", { "session.id": sessionID })
             break
           }
