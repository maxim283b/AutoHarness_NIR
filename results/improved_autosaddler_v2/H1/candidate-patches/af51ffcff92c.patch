diff --git a/opencode-src/packages/opencode/src/tool/test-guard.ts b/opencode-src/packages/opencode/src/tool/test-guard.ts
new file mode 100644
index 0000000..e0f504a
--- /dev/null
+++ b/opencode-src/packages/opencode/src/tool/test-guard.ts
@@ -0,0 +1,55 @@
+import * as MessageV2 from "@/session/message-v2"
+
+// Tool IDs of the file-editing tools. Kept as plain strings to avoid
+// import cycles with the tool modules themselves.
+export const EDIT_TOOLS: ReadonlySet<string> = new Set(["write", "edit", "apply_patch"])
+
+// Shell tool ID.
+export const SHELL_TOOL = "bash"
+
+const TEST_COMMAND_PATTERNS: readonly RegExp[] = [
+  /pytest|\bunittest\b|\bnose2?\b/,
+  /\bjest\b|\bvitest\b|\bmocha\b|\bkarma\b|\bcypress\b|playwright/,
+  /\brspec\b|\bminitest\b|\bcucumber\b/,
+  /\bphpunit\b|\bpest\b|\bcodecept/,
+  /\btox\b|\bnox\b/,
+  /\bgo\s+test\b|\bcargo\s+test\b|\bmix\s+test\b|\bmvn\s+test\b|gradle\b[^\n]*\btest\b|\bdotnet\s+test\b/,
+  /\bmake\s+(?:test|check)\b/,
+  /(?:npm|yarn|pnpm|bun)\s+(?:run\s+)?test/,
+  /(?:^|[\s/=.:_-])(?:tests?|specs?)(?:[\s/=.:_-]|$)/,
+]
+
+// Heuristic: does this shell command look like it runs a project's tests?
+export function looksLikeTestCommand(command: string): boolean {
+  if (!command) return false
+  const cmd = command.toLowerCase()
+  return TEST_COMMAND_PATTERNS.some((re) => re.test(cmd))
+}
+
+// Short reminder appended to successful edit-tool outputs.
+export const TEST_GUARD_SUFFIX =
+  "Reminder: verify this change by running the project's tests before declaring the task complete."
+
+// True when the conversation contains completed edit-tool calls but no
+// test-like shell command ran after the most recent edit.
+export function needsSelfVerify(msgs: MessageV2.WithParts[]): boolean {
+  let sawEdit = false
+  let verified = false
+  for (const msg of msgs) {
+    for (const part of msg.parts) {
+      if (part.type !== "tool") continue
+      const state = part.state
+      if (state.status !== "completed") continue
+      if (EDIT_TOOLS.has(part.tool)) {
+        sawEdit = true
+        verified = false
+        continue
+      }
+      if (part.tool === SHELL_TOOL) {
+        const command = typeof state.input?.command === "string" ? state.input.command : ""
+        if (looksLikeTestCommand(command)) verified = true
+      }
+    }
+  }
+  return sawEdit && !verified
+}
